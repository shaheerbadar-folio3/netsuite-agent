# Copy to .env. Never commit credentials or put them in the business document.
AGENT_ACCOUNT=1234567_SB1
AGENT_RESTLET_URL=https://1234567-sb1.restlets.api.netsuite.com/app/site/hosting/restlet.nl?script=123&deploy=1
AGENT_CLIENT_ID=
AGENT_CERTIFICATE_ID=
AGENT_PRIVATE_KEY_PATH=secrets/private.pem
AGENT_JWT_ALGORITHM=PS256
AGENT_OLLAMA_URL=http://127.0.0.1:11434
AGENT_MODEL=qwen3.5:4b
AGENT_CONTEXT_TOKENS=8192
AGENT_DOCUMENT_PATH=knowledge/business.md
AGENT_DATA_DIR=data
# Random local management bearer token, required to start the HTTP service.
AGENT_MANAGEMENT_TOKEN=
AGENT_POLL_SECONDS=2
AGENT_SCHEMA_REFRESH_SECONDS=3600
# Full account rescan interval. Routine refreshes only re-probe core/new/failed tables.
AGENT_SCHEMA_FULL_REFRESH_SECONDS=86400
AGENT_SCHEMA_PROBE_BATCH_SIZE=12
AGENT_SCHEMA_PROBE_CONCURRENCY=2
# Comma-separated SuiteQL names preferred on incremental refresh (defaults apply if empty).
# AGENT_SCHEMA_CORE_TABLES=customer,vendor,transaction,transactionline,item
# Keep inference budgets short so clarify/errors return quickly on CPU models.
AGENT_INFERENCE_TIMEOUT=90
AGENT_RETENTION_DAYS=7
AGENT_WORKER_ID=local-primary

# Optional approved creation. Also enable the RESTlet deployment parameter.
AGENT_CREATION_ENABLED=false
# New custom record TYPE deployment uses a separate SuiteCloud CI authentication ID.
# Create it with: suitecloud account:setup:ci --account <ACCOUNT> --authid agent-sdf \
#   --certificateid <CERT_ID> --privatekeypath <PRIVATE_KEY.pem>
# Then set ENABLED=true and AUTH_ID to that auth id. Restart the worker afterward.
AGENT_SDF_ENABLED=false
AGENT_SDF_AUTH_ID=
# Optional. Script ID of the OAuth integration custom role (customrole_...).
# New custom record types also grant this role FULL so entry creates work immediately.
# If empty, the worker resolves it automatically from a live ping.
AGENT_INTEGRATION_ROLE_ID=
AGENT_SUITECLOUD_BIN=suitecloud
AGENT_SDF_TIMEOUT=120

# Cap creation Ollama waits; explicit creates prefer deterministic drafts.
AGENT_CREATION_INFERENCE_TIMEOUT=90
# Optional: lower to 4096 on CPU Ollama if read plans feel slow.
# AGENT_CONTEXT_TOKENS=4096
